// Publica una nueva version de cloud-dashboard y deja que Argo CD la despliegue.
pipeline {
    agent any

    parameters {
        choice(name: 'BUMP', choices: ['patch', 'minor', 'major'],
               description: 'Parte de la version a incrementar')
    }

    environment {
        APP_DIR = 'Proyecto_5/iac/stack/app'
    }

    stages {
        stage('Release') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'aws-ecr-credentials',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                    sh "chmod +x ${APP_DIR}/release.sh && ${APP_DIR}/release.sh ${params.BUMP}"
                }
            }
        }

        stage('Push a git') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-credentials',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN')]) {
                    sh '''
                        set -eu
                        V="$(cat ${APP_DIR}/VERSION)"
                        git config user.email "jenkins@local"
                        git config user.name "Jenkins"
                        git commit -am "release(cloud-dashboard): v${V}"
                        git push "https://${GIT_USER}:${GIT_TOKEN}@github.com/dnunez-aquaware/Jenkins.git" HEAD:master
                    '''
                }
            }
        }
    }
}
