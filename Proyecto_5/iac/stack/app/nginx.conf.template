server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /health {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    location /api/info {
        default_type application/json;
        return 200 '{"application":"${APP_NAME}","version":"${APP_VERSION}","status":"running"}';
    }
}
